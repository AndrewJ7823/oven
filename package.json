{
  "name": "oven",
  "version": "1.0.0",
  "private": true,
  "description": "외부 애플리케이션이 전송한 쿠키를 Chrome 쿠키 저장소에 교체 적용하는 MV3 익스텐션",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewJ7823/oven.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ws:example": "node scripts/ws-server-example.mjs",
    "send": "node scripts/send-cookies.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release": "node scripts/release.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^2.3.1",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
